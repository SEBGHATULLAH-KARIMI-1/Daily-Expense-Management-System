# --- اجرای محلی ---
PORT=5000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=expenses_db

# --- ورود و کاربران ---
# رمز تصادفی طولانی برای امضای توکن (در Render هم بگذارید)
JWT_SECRET=change-this-to-a-long-random-text
# اولین مدیر: فقط وقتی هیچ کاربری در دیتابیس نیست ساخته می‌شود
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-123

# --- انتشار آنلاین (Neon) ---
# اگر این را بگذارید، مقادیر DB_* بالا نادیده گرفته می‌شوند
# DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# آدرس سایت Netlify (روی Render در Environment تنظیم می‌شود)
# CLIENT_URL=https://your-site.netlify.app
